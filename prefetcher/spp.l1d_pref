#include "cache.h"

#define IP_TRACKER_COUNT 24
#define PREFETCH_DEGREE 4
#define MASK_IP 0xFF

#define SIGNATURE_TABLE_SIZE 64
#define SIGNATURE_HISTORY_LEN 4
#define UNIFORM_CONFIDENCE_THRESHOLD 2
#define SIGNATURE_CONFIDENCE_THRESHOLD 2
#define ACCURACY_WINDOW 32


// Currently the signature is not ip specific. If I get time, I shall update that as well
// similar to constant stride (I have added signature part rn)
class IP_TRACKER {
    public:
        // curr IP being tracked
        uint64_t ip;

        // last cache line accessed
        uint64_t last_cl_addr;

        // the stride between the last two access
        int64_t last_stride;

        //recent history (right now, starting with basic)
        uint16_t signature;
        uint8_t signature_len;

        // confidence of const stride
        uint8_t stride_confidence;

        uint32_t lru;

        // differentiating empty slot
        uint32_t  valid;

        IP_TRACKER() {
            ip=0;
            last_cl_addr=0;
            last_stride=0;
            signature=0;
            signature_len=0;
            stride_confidence=0;
            lru=0;
            valid=false;
        };
};

class SIGNATURE_ENTRY {
    public:
        // last history
        uint16_t signature;
        // stride after the signature
        int16_t next_stride;

        uint8_t confidence;
        bool valid;

        SIGNATURE_ENTRY(){
            signature=0;
            next_stride=0;
            confidence=0;
            valid=false;
        };
};

class ACCURACY_TRACKER{
    public:
        uint64_t last_issued;
        uint64_t last_useful;
        uint64_t window_issued;
        uint64_t window_useful;
        double accuracy;
        uint32_t degree;

        ACCURACY_TRACKER(){
            last_issued=0;
            last_useful=0;
            window_issued=0;
            window_useful=0;
            accuracy=0.0;
            degree=2;
        };

};

// I need to keep in mind that the prefetcher they have given us doesn't keep track of cpu
IP_TRACKER trackers[NUM_CPUS][IP_TRACKER_COUNT];

SIGNATURE_ENTRY signature_table[NUM_CPUS][SIGNATURE_TABLE_SIZE];
ACCURACY_TRACKER accuracy_tracker[NUM_CPUS];


// Work - To find the tradeoff between the no of bits used for this encoding (should we increase the no. of bits?)
static uint8_t encode_stride(int64_t stride){

    // to restrict the size of stride
    if(stride < -8) stride = -8;
    if(stride > 7) stride =7;

    // 4 bits
    return static_cast<uint8_t>(stride) & 0x0F;
}

// Encoding the sequence of strides in 1 entry
static uint16_t append_stride(uint16_t signature, int64_t stride)
{
    return static_cast<uint16_t>((signature << 4) | encode_stride(stride));
}

// Mixing the strides (hashing)(again, I can improve it once I build the basic prefetcher)
static uint32_t signature_index(uint16_t signature)
{
    return (signature ^ (signature >> 6) ^ (signature >> 11)) &
           (SIGNATURE_TABLE_SIZE - 1);
}

// mapping to next stride
static void train_signature(uint32_t cpu, uint16_t signature, int64_t stride)
{
    uint32_t index = signature_index(signature);
    SIGNATURE_ENTRY &entry = signature_table[cpu][index];

    if (!entry.valid || entry.signature != signature) {
        entry.signature = signature;
        entry.next_stride = static_cast<int16_t>(
            stride < -32768 ? -32768 : (stride > 32767 ? 32767 : stride));
        entry.confidence = 1;
        entry.valid = true;
        return;
    }

    if (entry.next_stride == stride) {
        if (entry.confidence < 3)
            entry.confidence++;
    } else {
        entry.next_stride = static_cast<int16_t>(
            stride < -32768 ? -32768 : (stride > 32767 ? 32767 : stride));
        entry.confidence = 1;
    }
}

static bool predict_signature(uint32_t cpu, uint16_t signature, int64_t &stride)
{
    SIGNATURE_ENTRY &entry =
        signature_table[cpu][signature_index(signature)];

    if (!entry.valid || entry.signature != signature ||
        entry.confidence < SIGNATURE_CONFIDENCE_THRESHOLD)
        return false;

    stride = entry.next_stride;
    return (stride != 0);
}

static void update_prefetch_accuracy(CACHE *cache)
{
    uint32_t cpu = cache->cpu;
    ACCURACY_TRACKER &state = accuracy_tracker[cpu];

    if (cache->pf_issued >= state.last_issued)
        state.window_issued += cache->pf_issued - state.last_issued;
    if (cache->pf_useful >= state.last_useful)
        state.window_useful += cache->pf_useful - state.last_useful;

    state.last_issued = cache->pf_issued;
    state.last_useful = cache->pf_useful;

    if (state.window_issued >= ACCURACY_WINDOW) {
        state.accuracy = static_cast<double>(state.window_useful) /
                         static_cast<double>(state.window_issued);
        if (state.accuracy > 1.0)
            state.accuracy = 1.0;

        if (state.accuracy < 0.20)
            state.degree = 1;
        else if (state.accuracy < 0.40)
            state.degree = 2;
        else if (state.accuracy < 0.60)
            state.degree = 3;
        else
            state.degree = PREFETCH_DEGREE;

        state.window_issued = 0;
        state.window_useful = 0;
    }
}



void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;

    cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher (SPP)" << endl;

    for (int i = 0; i < IP_TRACKER_COUNT; i++)
        trackers[cpu][i] = IP_TRACKER();

    for (int i = 0; i < SIGNATURE_TABLE_SIZE; i++)
        signature_table[cpu][i] = SIGNATURE_ENTRY();

    accuracy_tracker[cpu] = ACCURACY_TRACKER();
    accuracy_tracker[cpu].last_issued = pf_issued;
    accuracy_tracker[cpu].last_useful = pf_useful;

    for (int i = 0; i < IP_TRACKER_COUNT; i++)
        trackers[cpu][i].lru = i;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
   update_prefetch_accuracy(this);

    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    ip = ip & MASK_IP;

    int index = -1;
    for (index = 0; index < IP_TRACKER_COUNT; index++) {
        if (trackers[cpu][index].valid && trackers[cpu][index].ip == ip)
            break;
    }

    if (index == IP_TRACKER_COUNT) {
        for (index = 0; index < IP_TRACKER_COUNT; index++) {
            if (!trackers[cpu][index].valid)
                break;
        }

        if (index == IP_TRACKER_COUNT) {
            for (index = 0; index < IP_TRACKER_COUNT; index++) {
                if (trackers[cpu][index].lru == (IP_TRACKER_COUNT - 1))
                    break;
            }
        }

        uint32_t old_lru = trackers[cpu][index].lru;
        trackers[cpu][index] = IP_TRACKER();
        trackers[cpu][index].ip = ip;
        trackers[cpu][index].last_cl_addr = cl_addr;
        trackers[cpu][index].valid = true;
        trackers[cpu][index].lru = old_lru;

        for (int i = 0; i < IP_TRACKER_COUNT; i++) {
            if (i != index && trackers[cpu][i].lru < old_lru)
                trackers[cpu][i].lru++;
        }
        trackers[cpu][index].lru = 0;
        return;
    }

    IP_TRACKER &tracker = trackers[cpu][index];

    int64_t stride = 0;
    if (cl_addr > tracker.last_cl_addr)
        stride = static_cast<int64_t>(cl_addr - tracker.last_cl_addr);
    else if (cl_addr < tracker.last_cl_addr)
        stride = -static_cast<int64_t>(tracker.last_cl_addr - cl_addr);

    if (stride == 0)
        return;

    if (tracker.signature_len >= SIGNATURE_HISTORY_LEN)
        train_signature(cpu, tracker.signature, stride);

    if (stride == tracker.last_stride) {
        if (tracker.stride_confidence < 3)
            tracker.stride_confidence++;
    } else {
        tracker.stride_confidence = 0;
    }
    tracker.last_cl_addr = cl_addr;
    tracker.last_stride = stride;

    tracker.signature = append_stride(tracker.signature, stride);
    if (tracker.signature_len < SIGNATURE_HISTORY_LEN)
        tracker.signature_len++;

    uint32_t degree = accuracy_tracker[cpu].degree;
    uint64_t current_page = addr >> LOG2_PAGE_SIZE;

    if (tracker.stride_confidence >= UNIFORM_CONFIDENCE_THRESHOLD) {
        for (uint32_t i = 0; i < degree; i++) {
            int64_t candidate_cl =
                static_cast<int64_t>(cl_addr) + stride * (i + 1);

            if (candidate_cl < 0)
                break;

            uint64_t pf_address =
                static_cast<uint64_t>(candidate_cl) << LOG2_BLOCK_SIZE;

            if ((pf_address >> LOG2_PAGE_SIZE) != current_page)
                break;


            if (MSHR.occupancy < (MSHR.SIZE >> 1))
                prefetch_line(ip, addr, pf_address, FILL_L1, 0);
            else
                prefetch_line(ip, addr, pf_address, FILL_L2, 0);
        }
    } else if (tracker.signature_len >= SIGNATURE_HISTORY_LEN) {

        uint64_t predicted_cl = cl_addr;
        uint16_t predicted_signature = tracker.signature;

        for (uint32_t i = 0; i < degree; i++) {
            int64_t next_stride = 0;
            if (!predict_signature(cpu, predicted_signature, next_stride))
                break;

            int64_t candidate_cl =
                static_cast<int64_t>(predicted_cl) + next_stride;
            if (candidate_cl < 0)
                break;

            uint64_t pf_address =
                static_cast<uint64_t>(candidate_cl) << LOG2_BLOCK_SIZE;

            if ((pf_address >> LOG2_PAGE_SIZE) != current_page)
                break;

            if (MSHR.occupancy < (MSHR.SIZE >> 1))
                prefetch_line(ip, addr, pf_address, FILL_L1, 0);
            else
                prefetch_line(ip, addr, pf_address, FILL_L2, 0);

            predicted_cl = static_cast<uint64_t>(candidate_cl);
            predicted_signature =
                append_stride(predicted_signature, next_stride);
        }
    }

    for (int i = 0; i < IP_TRACKER_COUNT; i++) {
        if (trackers[cpu][i].lru < tracker.lru)
            trackers[cpu][i].lru++;
    }
    tracker.lru = 0;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{
    ACCURACY_TRACKER &state = accuracy_tracker[cpu];
    double final_accuracy = state.accuracy;

    if (state.window_issued > 0) {
        final_accuracy = static_cast<double>(state.window_useful) /
                         static_cast<double>(state.window_issued);
        if (final_accuracy > 1.0)
            final_accuracy = 1.0;
    }

    cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher final stats" << endl;
    cout << "Degree: " << state.degree << endl;
    cout << "Latest accuracy: " << (100.0 * final_accuracy) << "%" << endl;
    cout << "Unfinished window issued: " << state.window_issued << endl;
    cout << "Unfinished window useful: " << state.window_useful << endl;
}